    {"type":"range","id":"intro_line_mobile","label":"Einleitung Zeilenhöhe Mobil","min":110,"max":220,"step":5,"unit":"%","default":170},
    {"type":"range","id":"intro_letter","label":"Einleitung Buchstabenabstand","min":-1,"max":4,"step":0.1,"unit":"px","default":0},
    {"type":"range","id":"intro_width","label":"Einleitung maximale Breite","min":280,"max":900,"step":20,"unit":"px","default":560},
    {"type":"range","id":"heading_size","label":"Überschrift Desktop","min":32,"max":110,"step":2,"unit":"px","default":72},
    {"type":"range","id":"heading_size_mobile","label":"Überschrift Mobil","min":28,"max":70,"step":1,"unit":"px","default":48},
    {"type":"range","id":"heading_line","label":"Überschrift Zeilenhöhe Desktop","min":75,"max":160,"step":1,"unit":"%","default":96},
    {"type":"range","id":"heading_line_mobile","label":"Überschrift Zeilenhöhe Mobil","min":80,"max":170,"step":1,"unit":"%","default":100},
    {"type":"range","id":"heading_letter","label":"Überschrift Buchstabenabstand","min":-4,"max":4,"step":0.1,"unit":"px","default":-2.4},
    {"type":"select","id":"heading_weight","label":"Überschrift Stärke","default":"400","options":[{"value":"400","label":"Normal"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}]},
    {"type":"select","id":"heading_align","label":"Überschrift Ausrichtung","default":"left","options":[{"value":"left","label":"Links"},{"value":"center","label":"Zentriert"},{"value":"right","label":"Rechts"}]},
    {"type":"header","content":"Farben"},
    {"type":"color","id":"background","label":"Hintergrund","default":"#f2eee5"},
