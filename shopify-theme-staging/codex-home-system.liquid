{% style %}
#shopify-section-{{ section.id }} .tw-system{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};color:{{ section.settings.text_color }}}
#shopify-section-{{ section.id }} .tw-system__head{display:grid;grid-template-columns:minmax(0,.42fr) minmax(0,1fr);gap:{{ section.settings.header_gap }}px;align-items:start}
#shopify-section-{{ section.id }} .tw-system__kicker{margin:0 0 {{ section.settings.kicker_margin }}px;color:{{ section.settings.kicker_color }};font-size:{{ section.settings.kicker_size }}px;line-height:{{ section.settings.kicker_line | divided_by: 100.0 }};letter-spacing:{{ section.settings.kicker_letter }}px;font-weight:{{ section.settings.kicker_weight }};text-transform:{{ section.settings.kicker_transform }}}
#shopify-section-{{ section.id }} .tw-system__intro{max-width:{{ section.settings.intro_width }}px;color:{{ section.settings.intro_color }};font-size:{{ section.settings.intro_size }}px;line-height:{{ section.settings.intro_line | divided_by: 100.0 }};letter-spacing:{{ section.settings.intro_letter }}px}
#shopify-section-{{ section.id }} .tw-system__title{margin:0;color:{{ section.settings.heading_color }};font-family:var(--font-display);font-size:{{ section.settings.heading_size }}px;line-height:{{ section.settings.heading_line | divided_by: 100.0 }};letter-spacing:{{ section.settings.heading_letter }}px;font-weight:{{ section.settings.heading_weight }};text-align:{{ section.settings.heading_align }}}
#shopify-section-{{ section.id }} .tw-system__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},minmax(0,1fr));gap:{{ section.settings.box_gap }}px;margin-top:{{ section.settings.box_margin_top }}px}
#shopify-section-{{ section.id }} .tw-system__card{min-height:var(--card-h);padding:var(--card-pt) var(--card-px) var(--card-pb);display:flex;flex-direction:column;justify-content:var(--card-justify);background:var(--card-bg);color:var(--card-heading);border:var(--card-border-width) solid var(--card-border);border-radius:var(--card-radius);overflow:hidden;transition:transform .25s ease,filter .25s ease}
#shopify-section-{{ section.id }} .tw-system__card:hover{transform:translateY({{ section.settings.hover_lift }}px);filter:brightness({{ section.settings.hover_brightness | divided_by: 100.0 }})}
#shopify-section-{{ section.id }} .tw-system__label{display:block;color:var(--card-label);font-size:var(--label-size);line-height:var(--label-line);letter-spacing:var(--label-letter);font-weight:var(--label-weight);text-transform:var(--label-transform)}
#shopify-section-{{ section.id }} .tw-system__card-title{margin:0;color:var(--card-heading);font-family:var(--font-display);font-size:var(--title-size);line-height:var(--title-line);letter-spacing:var(--title-letter);font-weight:var(--title-weight);text-align:var(--text-align)}
#shopify-section-{{ section.id }} .tw-system__card-text{max-width:var(--text-width);margin-top:var(--text-margin);color:var(--card-text);font-size:var(--text-size);line-height:var(--text-line);letter-spacing:var(--text-letter);text-align:var(--text-align)}
#shopify-section-{{ section.id }} .tw-system__card-text p{margin:0}
@media(max-width:1100px){#shopify-section-{{ section.id }} .tw-system__grid{grid-template-columns:repeat({{ section.settings.columns_tablet }},minmax(0,1fr))}}
@media(max-width:749px){
#shopify-section-{{ section.id }} .tw-system{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}
#shopify-section-{{ section.id }} .tw-system__head{grid-template-columns:1fr;gap:{{ section.settings.header_gap_mobile }}px}
#shopify-section-{{ section.id }} .tw-system__kicker{margin-bottom:{{ section.settings.kicker_margin_mobile }}px;font-size:{{ section.settings.kicker_size_mobile }}px}
#shopify-section-{{ section.id }} .tw-system__intro{font-size:{{ section.settings.intro_size_mobile }}px;line-height:{{ section.settings.intro_line_mobile | divided_by: 100.0 }}}
#shopify-section-{{ section.id }} .tw-system__title{font-size:{{ section.settings.heading_size_mobile }}px;line-height:{{ section.settings.heading_line_mobile | divided_by: 100.0 }}}
#shopify-section-{{ section.id }} .tw-system__grid{grid-template-columns:repeat({{ section.settings.columns_mobile }},minmax(0,1fr));gap:{{ section.settings.box_gap_mobile }}px;margin-top:{{ section.settings.box_margin_top_mobile }}px}
#shopify-section-{{ section.id }} .tw-system__card{min-height:var(--card-h-mobile);padding:var(--card-pt-mobile) var(--card-px-mobile) var(--card-pb-mobile)}
#shopify-section-{{ section.id }} .tw-system__label{font-size:var(--label-size-mobile)}
#shopify-section-{{ section.id }} .tw-system__card-title{font-size:var(--title-size-mobile)}
#shopify-section-{{ section.id }} .tw-system__card-text{font-size:var(--text-size-mobile);line-height:var(--text-line-mobile)}
}
{% endstyle %}
<section class="m10-section tw-system" data-tw-section-root>
  <div class="m10-shell">
    <div class="tw-system__head" data-reveal>
      <div>
        {% if section.settings.kicker != blank %}<p class="m10-kicker tw-system__kicker">{{ section.settings.kicker }}</p>{% endif %}
        {% if section.settings.intro != blank %}<div class="m10-body tw-system__intro">{{ section.settings.intro }}</div>{% endif %}
      </div>
      {% if section.settings.heading != blank %}<h2 class="m10-title tw-system__title">{{ section.settings.heading | newline_to_br }}</h2>{% endif %}
    </div>
    <div class="m10-domain-ribbon tw-system__grid" data-reveal>
      {% for block in section.blocks %}
        {% case block.settings.vertical_align %}{% when 'start' %}{% assign card_justify = 'flex-start' %}{% when 'center' %}{% assign card_justify = 'center' %}{% when 'end' %}{% assign card_justify = 'flex-end' %}{% else %}{% assign card_justify = 'space-between' %}{% endcase %}
        <a class="m10-domain-ribbon__item tw-system__card" href="{{ block.settings.link | default: '#' }}" style="--card-bg:{{ block.settings.background }};--card-label:{{ block.settings.label_color }};--card-heading:{{ block.settings.heading_color }};--card-text:{{ block.settings.body_color }};--card-border:{{ block.settings.border_color }};--card-border-width:{{ block.settings.border_width }}px;--card-radius:{{ block.settings.radius }}px;--card-h:{{ block.settings.min_height }}px;--card-h-mobile:{{ block.settings.min_height_mobile }}px;--card-pt:{{ block.settings.padding_top }}px;--card-pb:{{ block.settings.padding_bottom }}px;--card-px:{{ block.settings.padding_horizontal }}px;--card-pt-mobile:{{ block.settings.padding_top_mobile }}px;--card-pb-mobile:{{ block.settings.padding_bottom_mobile }}px;--card-px-mobile:{{ block.settings.padding_horizontal_mobile }}px;--card-justify:{{ card_justify }};--label-size:{{ block.settings.label_size }}px;--label-size-mobile:{{ block.settings.label_size_mobile }}px;--label-line:{{ block.settings.label_line | divided_by: 100.0 }};--label-letter:{{ block.settings.label_letter }}px;--label-weight:{{ block.settings.label_weight }};--label-transform:{{ block.settings.label_transform }};--title-size:{{ block.settings.heading_size }}px;--title-size-mobile:{{ block.settings.heading_size_mobile }}px;--title-line:{{ block.settings.heading_line | divided_by: 100.0 }};--title-letter:{{ block.settings.heading_letter }}px;--title-weight:{{ block.settings.heading_weight }};--text-size:{{ block.settings.body_size }}px;--text-size-mobile:{{ block.settings.body_size_mobile }}px;--text-line:{{ block.settings.body_line | divided_by: 100.0 }};--text-line-mobile:{{ block.settings.body_line_mobile | divided_by: 100.0 }};--text-letter:{{ block.settings.body_letter }}px;--text-width:{{ block.settings.body_width }}px;--text-margin:{{ block.settings.body_margin }}px;--text-align:{{ block.settings.text_align }}" {{ block.shopify_attributes }}>
          <span class="m10-domain-ribbon__number tw-system__label">{{ block.settings.label }}</span>
          <div><h3 class="m10-domain-ribbon__title tw-system__card-title">{{ block.settings.heading }}</h3>{% if block.settings.body != blank %}<div class="m10-domain-ribbon__text tw-system__card-text">{{ block.settings.body }}</div>{% endif %}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Codex Start — System",
  "tag":"section",
  "max_blocks":6,
  "settings":[
    {"type":"header","content":"Inhalt"},
    {"type":"text","id":"kicker","label":"Oberzeile","default":"Die Architektur"},
    {"type":"richtext","id":"intro","label":"Einleitung","default":"<p>Die Bereiche sind keine Kategorien zum Durchklicken. Sie bauen aufeinander auf: Zustand, Grundlage, Wirkung und die unsichtbare Mechanik darunter.</p>"},
    {"type":"textarea","id":"heading","label":"Überschrift","default":"Vier Ebenen.\nEin geschlossenes System."},
    {"type":"header","content":"Layout"},
    {"type":"range","id":"padding_top","label":"Abstand oben Desktop","min":0,"max":240,"step":4,"unit":"px","default":140},
    {"type":"range","id":"padding_bottom","label":"Abstand unten Desktop","min":0,"max":240,"step":4,"unit":"px","default":140},
