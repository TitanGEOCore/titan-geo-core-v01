{% style %}
#shopify-section-{{ section.id }} .tw-system{padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;background:{{ section.settings.background }};color:{{ section.settings.text_color }}}
#shopify-section-{{ section.id }} .tw-system__head{display:grid;grid-template-columns:.42fr 1fr;gap:{{ section.settings.header_gap }}px}
#shopify-section-{{ section.id }} .tw-system__title{margin:0;font-family:var(--font-display);font-size:{{ section.settings.heading_size }}px;line-height:{{ section.settings.heading_line | divided_by:100.0 }};letter-spacing:{{ section.settings.heading_letter }}px}
#shopify-section-{{ section.id }} .tw-system__intro{color:{{ section.settings.intro_color }};font-size:{{ section.settings.intro_size }}px;line-height:{{ section.settings.intro_line | divided_by:100.0 }}}
#shopify-section-{{ section.id }} .tw-system__grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop }},1fr);gap:{{ section.settings.gap }}px;margin-top:{{ section.settings.grid_top }}px}
#shopify-section-{{ section.id }} .tw-system__card{min-height:var(--h);padding:var(--p);display:flex;flex-direction:column;justify-content:space-between;background:var(--bg);color:var(--hc);border-radius:var(--r);border:var(--bw) solid var(--bc)}
#shopify-section-{{ section.id }} .tw-system__label{font-size:var(--ls);letter-spacing:var(--ll);color:var(--lc);text-transform:uppercase}
#shopify-section-{{ section.id }} .tw-system__card h3{margin:0;font-family:var(--font-display);font-size:var(--hs);line-height:var(--hl);letter-spacing:var(--hls);color:var(--hc)}
#shopify-section-{{ section.id }} .tw-system__text{margin-top:var(--tm);font-size:var(--ts);line-height:var(--tl);color:var(--tc)}
#shopify-section-{{ section.id }} .tw-system__text p{margin:0}
@media(max-width:749px){#shopify-section-{{ section.id }} .tw-system{padding:{{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px}#shopify-section-{{ section.id }} .tw-system__head{grid-template-columns:1fr;gap:32px}#shopify-section-{{ section.id }} .tw-system__title{font-size:{{ section.settings.heading_size_mobile }}px}#shopify-section-{{ section.id }} .tw-system__grid{grid-template-columns:repeat({{ section.settings.columns_mobile }},1fr);gap:{{ section.settings.gap_mobile }}px;margin-top:{{ section.settings.grid_top_mobile }}px}#shopify-section-{{ section.id }} .tw-system__card{min-height:var(--hm);padding:var(--pm)}#shopify-section-{{ section.id }} .tw-system__card h3{font-size:var(--hsm)}#shopify-section-{{ section.id }} .tw-system__text{font-size:var(--tsm)}}
{% endstyle %}
<section class="m10-section tw-system"><div class="m10-shell">
<div class="tw-system__head" data-reveal><div><p class="m10-kicker">{{ section.settings.kicker }}</p><div class="m10-body tw-system__intro">{{ section.settings.intro }}</div></div><h2 class="m10-title tw-system__title">{{ section.settings.heading | newline_to_br }}</h2></div>
<div class="m10-domain-ribbon tw-system__grid" data-reveal>{% for block in section.blocks %}<a class="m10-domain-ribbon__item tw-system__card" href="{{ block.settings.link }}" style="--bg:{{ block.settings.background }};--lc:{{ block.settings.label_color }};--hc:{{ block.settings.heading_color }};--tc:{{ block.settings.text_color }};--bc:{{ block.settings.border_color }};--bw:{{ block.settings.border_width }}px;--r:{{ block.settings.radius }}px;--h:{{ block.settings.min_height }}px;--hm:{{ block.settings.min_height_mobile }}px;--p:{{ block.settings.padding }}px;--pm:{{ block.settings.padding_mobile }}px;--ls:{{ block.settings.label_size }}px;--ll:{{ block.settings.label_letter }}px;--hs:{{ block.settings.heading_size }}px;--hsm:{{ block.settings.heading_size_mobile }}px;--hl:{{ block.settings.heading_line | divided_by:100.0 }};--hls:{{ block.settings.heading_letter }}px;--ts:{{ block.settings.text_size }}px;--tsm:{{ block.settings.text_size_mobile }}px;--tl:{{ block.settings.text_line | divided_by:100.0 }};--tm:{{ block.settings.text_margin }}px" {{ block.shopify_attributes }}><span class="m10-domain-ribbon__number tw-system__label">{{ block.settings.label }}</span><div><h3>{{ block.settings.heading }}</h3><div class="m10-domain-ribbon__text tw-system__text">{{ block.settings.text }}</div></div></a>{% endfor %}</div>
</div></section>
{% schema %}
