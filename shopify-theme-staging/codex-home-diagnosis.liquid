{% style %}
#shopify-section-{{ section.id }} .tw-diagnosis{padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px;background:{{ section.settings.bg }};color:{{ section.settings.fg }}}
#shopify-section-{{ section.id }} .tw-diagnosis__grid{display:grid;grid-template-columns:minmax(240px,.42fr) 1fr;gap:{{ section.settings.gap }}px}
#shopify-section-{{ section.id }} .tw-diagnosis__kicker{font-size:{{ section.settings.kicker_size }}px;line-height:{{ section.settings.kicker_lh | divided_by:100.0 }};letter-spacing:{{ section.settings.kicker_ls }}px;color:{{ section.settings.kicker_color }}}
#shopify-section-{{ section.id }} .tw-diagnosis__aside{font-size:{{ section.settings.aside_size }}px;line-height:{{ section.settings.aside_lh | divided_by:100.0 }};letter-spacing:{{ section.settings.aside_ls }}px;color:{{ section.settings.muted }}}
#shopify-section-{{ section.id }} .tw-diagnosis__title{font-size:{{ section.settings.title_size }}px;line-height:{{ section.settings.title_lh | divided_by:100.0 }};letter-spacing:{{ section.settings.title_ls }}px}
#shopify-section-{{ section.id }} .tw-diagnosis__rows{margin-top:{{ section.settings.rows_mt }}px}
#shopify-section-{{ section.id }} .tw-diagnosis__row{display:grid;grid-template-columns:{{ section.settings.label_width }}px 1fr;gap:{{ section.settings.row_gap }}px;padding:{{ section.settings.row_py }}px 0;border-top:1px solid {{ section.settings.line_color }}}
#shopify-section-{{ section.id }} .tw-diagnosis__row span{font-size:{{ section.settings.label_size }}px;letter-spacing:{{ section.settings.label_ls }}px;text-transform:uppercase;color:{{ section.settings.label_color }}}
#shopify-section-{{ section.id }} .tw-diagnosis__row p{margin:0;font-size:{{ section.settings.text_size }}px;line-height:{{ section.settings.text_lh | divided_by:100.0 }};letter-spacing:{{ section.settings.text_ls }}px;color:{{ section.settings.text_color }}}
#shopify-section-{{ section.id }} .tw-diagnosis__closing{margin-top:{{ section.settings.closing_mt }}px;font-size:{{ section.settings.closing_size }}px;line-height:{{ section.settings.closing_lh | divided_by:100.0 }};color:{{ section.settings.muted }}}
#shopify-section-{{ section.id }} .tw-diagnosis__link{margin-top:{{ section.settings.link_mt }}px;font-size:{{ section.settings.link_size }}px;letter-spacing:{{ section.settings.link_ls }}px;color:{{ section.settings.link_color }}}
@media(max-width:749px){#shopify-section-{{ section.id }} .tw-diagnosis{padding:{{ section.settings.pt_m }}px 0 {{ section.settings.pb_m }}px}#shopify-section-{{ section.id }} .tw-diagnosis__grid{grid-template-columns:1fr;gap:{{ section.settings.gap_m }}px}#shopify-section-{{ section.id }} .tw-diagnosis__title{font-size:{{ section.settings.title_size_m }}px}#shopify-section-{{ section.id }} .tw-diagnosis__row{grid-template-columns:1fr;gap:12px;padding:{{ section.settings.row_py_m }}px 0}#shopify-section-{{ section.id }} .tw-diagnosis__row p{font-size:{{ section.settings.text_size_m }}px}}
{% endstyle %}
<section class="m10-section tw-diagnosis"><div class="m10-shell"><div class="tw-diagnosis__grid" data-reveal><aside><p class="m10-kicker tw-diagnosis__kicker">{{ section.settings.kicker }}</p><div class="m10-body tw-diagnosis__aside">{{ section.settings.aside }}</div></aside><div><h2 class="m10-title tw-diagnosis__title">{{ section.settings.title }}</h2><div class="tw-diagnosis__rows">{% for block in section.blocks %}<div class="tw-diagnosis__row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><p>{{ block.settings.text }}</p></div>{% endfor %}</div><div class="tw-diagnosis__closing">{{ section.settings.closing }}</div><a class="m10-link tw-diagnosis__link" href="{{ section.settings.link }}">{{ section.settings.link_label }} <span aria-hidden="true">→</span></a></div></div></div></section>
{% schema %}
